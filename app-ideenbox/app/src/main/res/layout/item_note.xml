<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:background="@drawable/field" android:padding="12dp" android:minHeight="72dp" android:gravity="center_vertical">
    <TextView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="wrap_content" android:textSize="28sp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="19sp" android:maxLines="3" android:ellipsize="end" />
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/muted" />
    </LinearLayout>
</LinearLayout>
