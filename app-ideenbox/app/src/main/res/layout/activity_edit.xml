<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:orientation="horizontal">
        <Button android:id="@+id/btnIdea" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="💡 Idee" />
        <Button android:id="@+id/btnTodo" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="✅ ToDo" />
    </LinearLayout>

    <EditText android:id="@+id/edtText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minLines="5" android:gravity="top|start" android:textSize="22sp" android:padding="14dp"
        android:layout_margin="6dp" android:background="@drawable/field" android:textColor="@color/text"
        android:textColorHint="@color/muted" android:hint="Gedanke oder Aufgabe …"
        android:inputType="textMultiLine|textCapSentences|textAutoCorrect" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Erinnerung / Termin"
        android:textColor="@color/muted" android:textSize="16sp" android:paddingStart="8dp" android:paddingTop="8dp" />
    <Button android:id="@+id/btnWhen" style="@style/Big" android:layout_width="match_parent" android:layout_height="76dp"
        android:backgroundTint="@color/panel" android:text="kein Termin – antippen zum Wählen" android:textSize="20sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal">
        <Button android:id="@+id/btnQ1" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/accent" android:textSize="17sp" android:text="in 1 Std." />
        <Button android:id="@+id/btnQ2" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/accent" android:textSize="17sp" android:text="heute 17:00" />
        <Button android:id="@+id/btnQ3" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/accent" android:textSize="17sp" android:text="morgen 9:00" />
        <Button android:id="@+id/btnQ0" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/neutral" android:textSize="17sp" android:text="ohne" />
    </LinearLayout>

    <TextView android:id="@+id/txtInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="15sp" android:padding="8dp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button android:id="@+id/btnSave" style="@style/Big" android:layout_width="match_parent" android:layout_height="96dp"
        android:backgroundTint="@color/yes" android:textSize="30sp" android:text="SPEICHERN" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal">
        <Button android:id="@+id/btnDone" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/neutral" android:text="✔ Erledigt" android:textSize="20sp" />
        <Button android:id="@+id/btnDelete" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="@color/no" android:text="🗑 Löschen" android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
