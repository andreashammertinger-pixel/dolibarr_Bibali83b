<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:keepScreenOn="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/muted" />
        </LinearLayout>
        <Button android:id="@+id/btnSettings" style="@style/Big" android:layout_width="72dp" android:layout_height="64dp"
            android:text="⚙" android:textSize="28sp" android:backgroundTint="@color/neutral" android:contentDescription="Einstellungen" />
    </LinearLayout>

    <!-- Startansicht: zwei riesige Schaltflächen -->
    <LinearLayout android:id="@+id/idlePanel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:id="@+id/bigRow" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical">
            <Button android:id="@+id/btnIdea" style="@style/Big" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:backgroundTint="@color/idea" android:textColor="@color/dark_text"
                android:textSize="44sp" android:text="💡\nIDEE" />
            <Button android:id="@+id/btnTodo" style="@style/Big" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:backgroundTint="@color/todo" android:textSize="44sp" android:text="✅\nTODO" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:orientation="horizontal">
            <Button android:id="@+id/btnType" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:backgroundTint="@color/neutral" android:text="⌨  Tippen" />
            <Button android:id="@+id/btnList" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:backgroundTint="@color/neutral" android:text="☰  Liste" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sprachdialog -->
    <LinearLayout android:id="@+id/dialogPanel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/txtType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:paddingStart="8dp" android:paddingTop="4dp" />
        <TextView android:id="@+id/txtPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="30sp" android:textStyle="bold" android:padding="8dp" />
        <TextView android:id="@+id/txtMic" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎙  Ich höre …" android:textSize="22sp" android:textColor="#FFFF6B6B" android:paddingStart="8dp" android:visibility="invisible" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="@drawable/field" android:layout_margin="6dp">
            <TextView android:id="@+id/txtHeard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="26sp" android:padding="14dp" />
        </ScrollView>
        <LinearLayout android:id="@+id/rowTimes" android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal">
            <Button android:id="@+id/btnT1" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/accent" android:textSize="20sp" android:text="in 1 Std." />
            <Button android:id="@+id/btnT2" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/accent" android:textSize="20sp" android:text="heute 17:00" />
            <Button android:id="@+id/btnT3" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/accent" android:textSize="20sp" android:text="morgen 9:00" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowYesNo" android:layout_width="match_parent" android:layout_height="130dp" android:orientation="horizontal">
            <Button android:id="@+id/btnYes" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/yes" android:textSize="36sp" android:text="JA" />
            <Button android:id="@+id/btnNo" style="@style/Big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:backgroundTint="@color/no" android:textSize="36sp" android:text="NEIN" />
        </LinearLayout>
        <Button android:id="@+id/btnCancel" style="@style/Big" android:layout_width="match_parent" android:layout_height="80dp"
            android:backgroundTint="@color/neutral" android:text="✕  Abbrechen" />
    </LinearLayout>
</LinearLayout>
